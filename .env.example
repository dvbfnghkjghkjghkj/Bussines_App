# Токен бота Telegram (получить у @BotFather).
# В APK НЕ попадает: Android-версия отправляет заявку по deep link t.me,
# без токена. Переменная нужна только веб-сценарию с серверной прослойкой.
TELEGRAM_BOT_TOKEN=

# ID чата, куда приходят заявки (можно переопределить в config/company.json)
TELEGRAM_CHAT_ID=

# Подпись release-APK (секреты CI, локально — переменные окружения Gradle).
# Никогда не коммитить сам файл keystore.
# ANDROID_KEYSTORE_PATH=release.keystore
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
